# ===============================================
# AgriMate Production Environment Variables
# ===============================================

# Port to bind (defaults to 5001 locally, or dynamically assigned by PaaS host)
PORT=5001

# Environment mode
NODE_ENV=production

# Google Gemini API Key (Optional but recommended for live LLM inference)
# Get a key at: https://aistudio.google.com/app/apikey
# If omitted or expired, AgriMate activates verified regional fallbacks
# ensuring zero crash / 100% uptime during hackathon evaluations.
GEMINI_API_KEY=
