# ===============================================
# AgriMate Production Environment Variables
# ===============================================

# Port to bind (defaults to 5001 locally, or dynamically assigned by PaaS)
PORT=5001

# Environment mode
NODE_ENV=production

# Google Gemini API Key (Optional but recommended)
# Get a key at: https://aistudio.google.com/app/apikey
# If omitted, AgriMate uses verified deterministic agro-climatic fallbacks
# so the application remains 100% resilient and never crashes.
GEMINI_API_KEY=
